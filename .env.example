# ============================================
# WASTE MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ============================================

# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/waste_management
MONGODB_URI_TEST=mongodb://localhost:27017/waste_management_test

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Paystack (Payment Gateway)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# mNotify SMS (Ghana)
# https://app.mnotify.com → Developer API → API Key
# Sender ID must be pre-approved by mNotify (max 11 alphanumeric chars).
MNOTIFY_API_KEY=your_mnotify_api_key
MNOTIFY_SENDER_ID=WasteMgt
MNOTIFY_BASE_URL=https://api.mnotify.com/api

# Admin
ADMIN_EMAIL=admin@wastemanagement.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=0200000000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Monthly Billing
MONTHLY_FEE_BASIC=50
MONTHLY_FEE_STANDARD=80
MONTHLY_FEE_PREMIUM=120
BILLING_DUE_DAY=25
